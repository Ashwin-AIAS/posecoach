*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text

# Force LF regardless of core.autocrlf — a CRLF shebang line breaks exec() in
# the Linux container (repo's core.autocrlf=true would otherwise convert this
# back to CRLF on a Windows checkout).
docker-entrypoint.sh text eol=lf
